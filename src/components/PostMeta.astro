---
import type { Post } from '~/types'
import { formatDate } from '~/utils'

interface Props {
  post: Post
  mode?: 'list' | 'detail'
}

const { post } = Astro.props
---

<header class="writer-article-heading">
  <h1>{post.data.title}</h1>
  <time class="writer-date">{formatDate(post.data.modDate ?? post.data.pubDate)}</time>
</header>
