---
interface Props {
  id: string
}

const { id } = Astro.props
const gtmUrl = `https://www.googletagmanager.com/gtm.js?id=${id}`
---

<!-- Google Tag Manager -->
<script is:inline data-swup-ignore-script>
  window.dataLayer = window.dataLayer || []
  window.dataLayer.push({
    'gtm.start': new Date().getTime(),
    // eslint-disable-next-line style/quote-props
    event: 'gtm.js',
  })
</script>
<script is:inline async data-swup-ignore-script src={gtmUrl}></script>
<!-- End Google Tag Manager -->
<script is:inline data-swup-ignore-script>
  let lastPageLocation = window.location.href
  document.addEventListener('swup:page:view', () => {
    const pageLocation = window.location.href
    if (pageLocation === lastPageLocation) {
      return
    }

    lastPageLocation = pageLocation
    window.dataLayer.push({
      event: 'page_view',
      page_title: document.title,
      page_location: pageLocation,
      page_path: window.location.pathname,
    })
  })
</script>
