---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import LayoutPost from '~/layouts/LayoutPost.astro'
import { getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
const isFirstPage = page.currentPage === 1

const pageTitle = isFirstPage
  ? themeConfig.site.title
  : `인사이트 ${page.currentPage}페이지 | ${themeConfig.site.title}`

const pageDesc = isFirstPage
  ? themeConfig.site.description
  : `${themeConfig.site.title}의 인사이트 목록 ${page.currentPage}페이지입니다.`
const introParagraphs = themeConfig.site.description.split('\n\n')
---

<LayoutDefault>
  <SiteSeo slot="seo" title={pageTitle} desc={pageDesc} ogType="website" />

  {
    isFirstPage && (
      <section class="site-intro">
        {introParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )
  }

  <section class="writer-post-list">
    {page.data.map((post) => <LayoutPost post={post} mode="list" />)}
  </section>
  {
    page.lastPage > 1 && (
      <Pagination
        showLeft={Boolean(page.url.prev)}
        leftTitle={t('prev')}
        leftUrl={page.url.prev}
        showRight={Boolean(page.url.next)}
        rightTitle={t('next')}
        rightUrl={page.url.next}
        currentPage={page.currentPage}
        totalPage={page.lastPage}
      />
    )
  }
</LayoutDefault>
